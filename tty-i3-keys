def console_toggle_keys():
    """Keycodes mapped by the KEYMAP_TOGGLE file of /etc/vconsole.conf: the
    user's deliberate console bindings, which this daemon leaves alone."""
    try:
        with open("/etc/vconsole.conf") as f:
            conf = dict(line.strip().split("=", 1) for line in f
                        if "=" in line and not line.lstrip().startswith("#"))
        path = conf.get("KEYMAP_TOGGLE", "").strip('"')
        if not path.startswith("/"):
            return set()
        opener = gzip.open if path.endswith(".gz") else open
        with opener(path, "rt") as f:
            return {int(line.split()[1]) for line in f
                    if line.split()[:1] == ["keycode"]}
    except (OSError, ValueError, IndexError):
        return set()


KDGKBMODE, K_UNICODE = 0x4B44, 0x03
VT_GETSTATE = 0x5603


def unicode_vt():
    """An fd of an allocated VT whose keyboard is in Unicode mode, or None.

    The keymap is global, but KDGKBENT/KDSKBENT convert entries by the
    keyboard mode of the VT they are issued on: through a VT that is not in
    Unicode mode (X's VT, a raw-mode lock VT) Unicode entries read as
    K_HOLE and writing one fails with EINVAL (measured). /dev/tty0 is
    whatever VT is in front, so reading "original" entries through it while
    X is in front would record holes, and restoring them would write the
    holes over real keys. Candidates: the VT in front, then the allocated
    VTs 1-15 (VT_GETSTATE; opening an unallocated VT would allocate it)."""
    with open("/sys/class/tty/tty0/active") as f:
        front = int(f.read().strip()[3:])
    fd = os.open("/dev/tty0", os.O_RDONLY | os.O_NOCTTY)
    try:
        state = bytearray(6)
        fcntl.ioctl(fd, VT_GETSTATE, state)
        in_use = struct.unpack("HHH", state)[2]
    finally:
        os.close(fd)
    for vt in [front] + [n for n in range(1, 16) if in_use >> n & 1 and n != front]:
        try:
            fd = os.open(f"/dev/tty{vt}", os.O_RDONLY | os.O_NOCTTY)
        except OSError:
            continue
        mode = bytearray(4)
        try:
            fcntl.ioctl(fd, KDGKBMODE, mode)
            if struct.unpack("i", mode)[0] == K_UNICODE:
                return fd
        except OSError:
            pass
        os.close(fd)
    return None


class Keymap:
    """Console keymap entries this daemon owns, set in every allocated table:
    the Win keys become the kernel's ShiftL modifier - no table for a ShiftL
    combination exists (checked), so the kernel types nothing for Win+key
    (but arrows: KT_CUR/KT_CSI keys fall back to the plain map) and
    recomputes the modifier state when Win is released - and the media
    keys it handles become holes, so they do not also type F13/F14/Help.
    Only allocated tables are touched: writing even a hole into a missing
    table allocates it. Re-applied if something reloads the keymap
    (loadkeys, systemd-vconsole-setup); restored on exit.

    The original entries are written to KEYMAP_STATE before the first change
    and read back by the next instance: an instance that dies without
    restoring (SIGKILL, a crash) leaves its changes in the kernel, and the
    next one would otherwise take them for the originals and "restore" them
    on exit, leaving Win and the media keys dead for good."""

    def __init__(self, entries):
        # /dev/tty0 opens the console in front at that moment, and an open
        # console cannot be freed: open it only for each use, or a daemon
        # started on the lock's spare VT would pin that VT forever.
        self.fd = None
        self.entries = entries      # keycode -> value to set
        self.saved = self.load()    # (table, keycode) -> original entry
        self.no_unicode_vt = False
        self.warned = False

    def open_unicode_vt(self):
        fd = unicode_vt()
        if fd is None:
            if not self.no_unicode_vt:
                print("keymap: no VT in Unicode mode, keymap left alone until "
                      "there is one", flush=True)
            self.no_unicode_vt = True
        else:
            self.no_unicode_vt = False
        return fd

    @staticmethod
    def load():
        saved = {}
        try:
            with open(KEYMAP_STATE) as f:
                for line in f:
                    table, keycode, value = (int(x, 0) for x in line.split())
                    saved[table, keycode] = value
        except FileNotFoundError:
            return saved
        except (OSError, ValueError):
            traceback.print_exc()
            return saved
        print(f"keymap: {len(saved)} original entries left by an instance "
              "that did not restore them", flush=True)
        return saved

    def store(self):
        os.makedirs(os.path.dirname(KEYMAP_STATE), exist_ok=True)
        with open(KEYMAP_STATE + ".new", "w") as f:
            f.writelines(f"{t} {k} {v:#06x}\n"
                         for (t, k), v in sorted(self.saved.items()))
            f.flush()
            os.fsync(f.fileno())
        os.replace(KEYMAP_STATE + ".new", KEYMAP_STATE)

    def get(self, table, keycode):
        buf = bytearray(struct.pack("BBH", table, keycode, 0))
        fcntl.ioctl(self.fd, KDGKBENT, buf)
        return struct.unpack("BBH", buf)[2]

    def set(self, table, keycode, value):
        fcntl.ioctl(self.fd, KDSKBENT, struct.pack("BBH", table, keycode, value))

    def tables(self):
        return [t for t in range(NR_KEYMAPS) if self.get(t, 0) != K_NOSUCHMAP]

    def apply(self):
        self.fd = self.open_unicode_vt()
        if self.fd is None:
            return
        try:
            self._apply()
        finally:
            os.close(self.fd)
            self.fd = None

    def _apply(self):
        tables = self.tables()
        entries = self.entries
        clash = [t for t in tables if t & KG_SHIFTL_BIT]
        if clash:
            # Win as ShiftL would select these tables and type their keys.
            if not self.warned:
                print(f"keymap uses ShiftL (tables {clash}): Win keys left "
                      "alone, Win+key will also type", flush=True)
                self.warned = True
            entries = {k: v for k, v in entries.items() if v != K_SHIFTL}
        changes = []
        for table in tables:
            for keycode, wanted in entries.items():
                value = self.get(table, keycode)
                if value != wanted:
                    # A value other than ours is the original (or a reloaded
                    # keymap's, which is the one to keep).
                    changes.append((table, keycode, value, wanted))
        if not changes:
            return
        for table, keycode, value, _ in changes:
            self.saved[table, keycode] = value
        self.store()            # before the change: a crash leaves the record
        for table, keycode, _, wanted in changes:
            self.set(table, keycode, wanted)
        print(f"keymap: set {len(changes)} entries: " + ", ".join(
            f"t{t}/k{k} {old:#06x}->{new:#06x}" for t, k, old, new in changes[:6])
            + (" ..." if len(changes) > 6 else ""), flush=True)

    def restore(self):
        """Put back the entries as they were when last set: after a keymap
        reload that is the reloaded value, which is the one to keep."""
        self.fd = self.open_unicode_vt()
        if self.fd is None:
            return
        try:
            self._restore()
        finally:
            os.close(self.fd)
            self.fd = None

    def _restore(self):
        tables = set(self.tables())
        failed = False
        for (table, keycode), value in self.saved.items():
            if table in tables:
                try:
                    self.set(table, keycode, value)
                except OSError:
                    traceback.print_exc()
                    failed = True
        print(f"keymap: restored {len(self.saved)} entries", flush=True)
        if not failed:
            try:
                os.unlink(KEYMAP_STATE)
            except FileNotFoundError:
                pass


def device_name(fd):
    """The input device's name, for the log."""
    buf = bytearray(256)
    try:
        n = fcntl.ioctl(fd, 0x81004506, buf)     # EVIOCGNAME(256)
    except OSError:
        return f"fd {fd}"
    return bytes(buf[:max(0, n - 1)]).decode(errors="replace")


def is_keyboard(path, media_keys):
    """The device's fd if it is a keyboard (KEY_S and KEY_LEFTMETA) or
    reports one of the media keys handled here, else None."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    bits = bytearray(96)
    try:
        fcntl.ioctl(fd, EVIOCGBIT_EV_KEY, bits)
    except OSError:
        os.close(fd)
        return None
    has = lambda code: bits[code // 8] >> (code % 8) & 1
    if (has(KEY_S) and has(KEY_LEFTMETA)) or any(map(has, media_keys)):
        return fd
    os.close(fd)
    return None


def scan(open_fds, media_keys):
    known = set(open_fds.values())
    for path in glob.glob("/dev/input/event*"):
        if path not in known:
            fd = is_keyboard(path, media_keys)
            if fd is not None:
                open_fds[fd] = path


def foreground_vt():
    """/dev/ttyN of the foreground VT, text or graphics."""
    with open("/sys/class/tty/tty0/active") as f:
        return "/dev/" + f.read().strip()


def foreground_text_vt():
    """Return /dev/ttyN of the foreground VT if it is in text mode, else None."""
    with open("/sys/class/tty/tty0/active") as f:
        tty = "/dev/" + f.read().strip()
    fd = os.open(tty, os.O_RDONLY | os.O_NOCTTY)
    try:
        mode = bytearray(4)
        fcntl.ioctl(fd, KDGETMODE, mode)
    finally:
        os.close(fd)
    return tty if struct.unpack("i", mode)[0] == KD_TEXT else None


def user_env(user):
    """The environment of the user's session (XDG_RUNTIME_DIR reaches their
    PipeWire), and nothing of root's."""
    return {"HOME": user.pw_dir, "PATH": "/usr/local/bin:/usr/bin",
            "LANG": "C.UTF-8", "XDG_RUNTIME_DIR": f"/run/user/{user.pw_uid}"}


def user_identity(uid):
    user = pwd.getpwuid(uid)
    return user, {"user": uid, "group": user.pw_gid,
                  "extra_groups": os.getgrouplist(user.pw_name, user.pw_gid),
                  "env": user_env(user)}


def as_user(uid, argv, stderr=False):
    """Run a command as `uid`, never as root; return (exit status, output).
    The command is the user's to control: it is killed after
    COMMAND_SECONDS and only the first OUTPUT_LIMIT bytes are kept. With
    `stderr`, its error output is part of the output."""
    _, identity = user_identity(uid)
    proc = subprocess.Popen(
        argv, **identity, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT if stderr else subprocess.DEVNULL,
        start_new_session=True)
    out = b""
    deadline = time.monotonic() + COMMAND_SECONDS
    try:
        while len(out) < OUTPUT_LIMIT:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([proc.stdout], [], [], left)[0]:
                break
            chunk = os.read(proc.stdout.fileno(), OUTPUT_LIMIT - len(out))
            if not chunk:
                break
            out += chunk
    finally:
        proc.stdout.close()
        try:
            proc.wait(max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
    return proc.returncode, out.decode(errors="replace").strip()


# --- Actions; their feedback goes to the bar (Bar.notify) ----------------

DICTATION_SOCKET = "/run/user/{uid}/nerd-dictation-ex.sock"
DICTATION_SECONDS = 12          # the client gives up on the socket after 10 s
# Sends nerd-dictation's own "toggle" command and prints its JSON reply, or
# "not running" when there is no daemon to talk to.
DICTATION_CLIENT = """
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(sys.argv[1])
except OSError:
    print(json.dumps({"status": "not running"}))
    sys.exit()
try:
    s.send(json.dumps({"action": "toggle"}).encode())
    sys.stdout.write(s.recv(4096).decode(errors="replace"))
except OSError as e:
    print(json.dumps({"status": "error", "message": str(e)}))
"""


class Dictation:
    """Toggles the nerd-dictation daemon of the user who owns the console,
    as console-mouse's middle click does. The socket lives in a directory
    that user controls, so the client runs as that user, never as root, and
    only one request is in flight. Its reply goes to the bar."""

    def __init__(self):
        self.child = None
        self.deadline = 0.0

    def toggle(self, tty, bar):
        uid = os.stat(tty).st_uid
        if uid == 0:
            return  # login prompt: nobody to act for
        if self.child is not None:
            bar.notify("Dictation: previous request still pending", WARNING)
            return
        user = pwd.getpwuid(uid)
        self.child = subprocess.Popen(
            [sys.executable, "-c", DICTATION_CLIENT,
             DICTATION_SOCKET.format(uid=uid)],
            user=uid, group=user.pw_gid, extra_groups=[], env={},
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, start_new_session=True)
        self.deadline = time.monotonic() + DICTATION_SECONDS

    def fileno(self):
        return self.child.stdout.fileno() if self.child else None

    def timeout(self):
        return max(0.0, self.deadline - time.monotonic()) if self.child else None

    def tick(self, bar):
        """Give up on a client that outlived its deadline."""
        if self.child and time.monotonic() >= self.deadline:
            self.finish(bar, b"")

    def ready(self, bar):
        self.finish(bar, os.read(self.child.stdout.fileno(), OUTPUT_LIMIT))

    def finish(self, bar, out):
        child, self.child = self.child, None
        child.stdout.close()
        try:
            child.wait(1)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL)
            child.wait()
        try:
            reply = json.loads(out.decode(errors="replace"))
        except ValueError:
            reply = {"status": "error", "message": "no reply"}
        print(f"dictation toggle: {reply}", flush=True)
        if reply.get("status") == "ok":
            bar.notify(f"Dictation: {reply.get('message', 'ok')}", INFO)
        elif reply.get("status") == "not running":
            bar.notify("Dictation: not running", WARNING)
        else:
            bar.notify(f"Dictation: {reply.get('message', 'error')}", WARNING)

    def stop(self):
        if self.child:
            os.killpg(self.child.pid, signal.SIGKILL)
            self.child.wait()
            self.child = None

def toggle(tty, bar):
    uid = os.stat(tty).st_uid
    if uid == 0:
        return  # login prompt: nobody to act for
    user, identity = user_identity(uid)
    script = os.path.join(user.pw_dir, SCRIPT)
    # The inhibitor left running by "toggle" inherits stdout: never pipe it.
    subprocess.run([script, "toggle"], **identity,
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=COMMAND_SECONDS)
    status, text = as_user(uid, [script, "status"])
    bar.notify(text or f"{SCRIPT} status failed",
               INFO if status == 0 and text else ERROR)


def tmux_client(tty, uid):
    """(socket, session id) of the tmux client attached to `tty`, or None.
    tmux runs as the VT's owner, never as root: its socket directory belongs
    to the user, and a root client would act on whatever the user put there.
    A root daemon has no $TMUX_TMPDIR: look in tmux's default directory."""
    # The directory is the user's: bound how many sockets we ask.
    for sock in sorted(glob.glob(f"/tmp/tmux-{uid}/*"))[:MAX_TMUX_SOCKETS]:
        try:
            if not stat.S_ISSOCK(os.lstat(sock).st_mode):
                continue
            _, clients = as_user(uid, ["tmux", "-S", sock, "list-clients",
                                       "-F", "#{client_tty} #{session_id}"])
        except OSError:
            continue
        for line in clients.splitlines():
            client_tty, _, session = line.partition(" ")
            if client_tty == tty:
                return sock, session
    return None


def select_window(tty, index, bar):
    """Select window `index` in the tmux session attached to `tty`."""
    uid = os.stat(tty).st_uid
    if uid == 0:
        return  # login prompt: nobody to act for
    client = tmux_client(tty, uid)
    if not client:
        bar.notify("No tmux on this console", WARNING)
        return
    sock, session = client
    status, error = as_user(uid, ["tmux", "-S", sock, "select-window", "-t",
                                  f"{session}:{index}"], stderr=True)
    if status != 0:
        bar.notify(f"tmux: {error or f'no window {index}'}", ERROR)


def volume(tty, code, bar):
    uid = os.stat(tty).st_uid
    if uid == 0:
        return  # login prompt: no user session to change
    status, error = as_user(uid, VOLUME[code], stderr=True)
    if status != 0:
        bar.notify(f"Volume: {error or 'pamixer failed'}", ERROR)
        return
    # i3 also refreshes its status bar this way.
    as_user(uid, ["pkill", "-RTMIN+1", "-u", str(uid), "i3blocks"])
    _, level = as_user(uid, ["pamixer", "--get-volume-human"])
    bar.notify(f"Volume: {level}", INFO)


def brightness(tty, code, bar):
    # brightnessctl keeps at least 1 (its default --min-value): never black.
    run = lambda argv: subprocess.run(argv, stdin=subprocess.DEVNULL,
                                      capture_output=True, text=True,
                                      timeout=COMMAND_SECONDS)
    result = run(BRIGHTNESS[code])
    if result.returncode != 0:
        bar.notify(f"Brightness: {result.stderr.strip() or 'failed'}", ERROR)
        return
    info = run(["brightnessctl", "-m"]).stdout.split(",")
    bar.notify(f"Brightness: {info[3] if len(info) > 3 else '?'}", INFO)


def set_rotation(quarter):
    """Rotate every console by `quarter` * 90 degrees clockwise and keep it
    for the next boot."""
    with open(FBCON_ROTATE_ALL, "w") as f:
        f.write(str(quarter))
    os.makedirs(os.path.dirname(ROTATION_STATE), exist_ok=True)
    with open(ROTATION_STATE + ".new", "w") as f:
        f.write(f"{quarter}\n")
    os.replace(ROTATION_STATE + ".new", ROTATION_STATE)


def restore_rotation():
    """At start: the rotation chosen last time, if any."""
    try:
        with open(ROTATION_STATE) as f:
            quarter = int(f.read().strip()) % 4
        if os.path.exists(FBCON_ROTATE_ALL):
            set_rotation(quarter)
    except (OSError, ValueError):
        pass


def rotate(bar):
    """Win+O: the next quarter turn clockwise."""
    try:
        with open(FBCON_ROTATE) as f:
            quarter = (int(f.read().strip()) + 1) % 4
        # The bar row belongs to the old geometry: put it back first.
        bar.hide()
        set_rotation(quarter)
    except (OSError, ValueError) as e:
        bar.notify(f"Rotation: {e}", ERROR)
        return
    bar.notify(f"Rotation: {quarter * 90} degrees", INFO)


def sysfs_bits(path):
    """A capability bitmap from sysfs (hex words, most significant first)."""
    try:
        with open(path) as f:
            words = f.read().split()
    except OSError:
        return 0
    value = 0
    for word in words:
        value = (value << 64) | int(word, 16)
    return value


def pointer_devices():
    """sysfs dirs of mice, TrackPoints and touchpads: relative X/Y with a
    left button, or absolute X/Y with a finger tool and INPUT_PROP_POINTER.
    Touchscreens (INPUT_PROP_DIRECT) are not among them."""
    found = []
    for dev in sorted(glob.glob("/sys/class/input/input*")):
        props = sysfs_bits(f"{dev}/properties")
        if props >> 1 & 1:                      # INPUT_PROP_DIRECT
            continue
        rel = sysfs_bits(f"{dev}/capabilities/rel")
        abs_ = sysfs_bits(f"{dev}/capabilities/abs")
        key = sysfs_bits(f"{dev}/capabilities/key")
        if ((rel & 3 == 3 and key >> 0x110 & 1)
                or (abs_ & 3 == 3 and key >> 0x145 & 1 and props & 1)):
            found.append(dev)
    return found


def set_inhibited(dev, value):
    with open(f"{dev}/inhibited", "w") as f:
        f.write(value)


class KeyboardLock:
    """Lock the keyboard for a convertible folded into a tablet, where the
    keys face the table: every keyboard this daemon reads is grabbed
    (EVIOCGRAB), so the console, X and every other reader get nothing, and
    mice, TrackPoints and touchpads are inhibited in sysfs. The touchscreen
    stays. The daemon keeps reading the grabbed keyboards: the volume
    buttons still change the volume, and pressing both of them together is
    the only way to unlock - a folded keyboard can press anything else.

    It needs both volume buttons: without them (or where the console keymap
    owns them) it refuses to lock, so there is always a way out. The grabs
    live with this process; the inhibited pointers are recorded in
    POINTERS_STATE before they are inhibited and put back on exit and, after
    a crash, when the daemon starts again.

    With the console screen lock (ttysecurelock) on, the chord still unlocks the
    keyboard, so the password can be typed; other keys stay dropped.

    The grab waits until no key but the volume buttons is held: a key
    released while grabbed stays down in the console's keyboard state, and a
    stuck Win (ShiftL in the console keymap here) selects a missing keymap
    table, so the console typed nothing at all after the unlock. The volume
    buttons are holes in the console keymap: a stuck one changes nothing."""

    def __init__(self, media_keys):
        self.possible = set(VOLUME_PAIR) <= media_keys
        self.locked = False
        self.grab_pending = False   # locked, waiting for the keys to come up
        self.grabbed = set()
        self.pending = None     # (code, deadline): a volume press
        self.chord = set()      # volume keys used up by a chord until released
        self.release_pointers()

    # Grabs and pointers.

    def grab(self, fds):
        for fd in fds:
            if fd not in self.grabbed:
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                    self.grabbed.add(fd)
                    print(f"keyboard lock: grabbed {device_name(fd)}", flush=True)
                except OSError as e:
                    # EBUSY: another process holds the grab (a test harness,
                    # another locker); its events do not reach the console.
                    print(f"keyboard lock: cannot grab {device_name(fd)}: "
                          f"{e.strerror}", flush=True)

    def settle(self, fds, held):
        """Grab once only the volume buttons (or nothing) are held."""
        if self.grab_pending and not held - set(VOLUME_PAIR):
            self.grab_pending = False
            self.grab(fds)

    def forget(self, fd, fds, bar):
        """A keyboard went away: its grab went with it, and so did whatever
        it held. If no keyboard with both volume buttons is left, nothing
        could unlock any more: unlock now."""
        self.grabbed.discard(fd)
        self.chord.clear()
        self.pending = None
        if self.locked and not self.unlockable(fds):
            self.unlock(fds, bar)

    @staticmethod
    def unlockable(fds):
        """Does one of the keyboards in `fds` have both volume buttons?"""
        for fd in fds:
            bits = bytearray(96)
            try:
                fcntl.ioctl(fd, EVIOCGBIT_EV_KEY, bits)
            except OSError:
                continue
            if all(bits[c // 8] >> (c % 8) & 1 for c in VOLUME_PAIR):
                return True
        return False

    def write_state(self, entries):
        if not entries:
            try:
                os.unlink(POINTERS_STATE)
            except FileNotFoundError:
                pass
            return
        os.makedirs(os.path.dirname(POINTERS_STATE), exist_ok=True)
        with open(POINTERS_STATE + ".new", "w") as f:
            f.write("".join(f"{dev}\t{name}\n" for dev, name in entries))
        os.replace(POINTERS_STATE + ".new", POINTERS_STATE)

    def release_pointers(self):
        """Un-inhibit what POINTERS_STATE says this daemon inhibited. A
        device is matched by its sysfs path and name (the number of a gone
        device can be reused); one that fails to come back stays recorded,
        for the next attempt."""
        try:
            with open(POINTERS_STATE) as f:
                entries = [tuple(line.rstrip("\n").split("\t", 1))
                           for line in f if "\t" in line]
        except FileNotFoundError:
            return
        failed = []
        for dev, name in entries:
            # Only real input devices: the file is root's, but be strict.
            if not re.fullmatch(r"/sys/class/input/input\d+", dev):
                continue
            try:
                with open(f"{dev}/name") as f:
                    if f.read().strip() != name:
                        continue    # gone, the number taken by another
                set_inhibited(dev, "0")
            except FileNotFoundError:
                continue            # unplugged: nothing left to restore
            except OSError:
                traceback.print_exc()
                failed.append((dev, name))
        self.write_state(failed)

    def inhibit_pointers(self):
        entries = []
        for dev in pointer_devices():
            try:
                with open(f"{dev}/inhibited") as f:
                    if f.read().strip() != "0":
                        continue
                with open(f"{dev}/name") as f:
                    entries.append((dev, f.read().strip()))
            except OSError:
                pass
        # Recorded before they are inhibited: a crash in between is undone.
        self.write_state(entries)
        for dev, _ in entries:
            try:
                set_inhibited(dev, "1")
            except OSError:
                traceback.print_exc()

    # Locking.

    def lock(self, fds, bar, held):
        if self.locked:
            return
        if not self.possible or not self.unlockable(fds):
            bar.notify("Keyboard lock needs both volume buttons", WARNING)
            return
        self.locked = True
        self.grab_pending = True
        print(f"keyboard lock: locked, grab when keys {sorted(held)} are up",
              flush=True)
        self.settle(fds, held)
        self.inhibit_pointers()
        bar.notify("Keyboard locked: press both volume buttons to unlock")

    def unlock(self, fds, bar):
        if not self.locked:
            return
        self.locked = False
        self.grab_pending = False
        print(f"keyboard lock: unlocked, releasing {len(self.grabbed)} grabs",
              flush=True)
        for fd in list(self.grabbed):
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 0)
            except OSError:
                pass
        self.grabbed.clear()
        self.release_pointers()
        bar.notify("Keyboard unlocked")

    def stop(self):
        """On exit: the grabs end with the process; the pointers do not."""
        self.release_pointers()

    # The volume buttons: a press waits CHORD_SECONDS for its pair.

    def volume_key(self, code, value, held, fds, bar, act):
        """Handle KEY_VOLUMEUP/DOWN; `act(code)` changes the volume.
        Returns nothing: the press is acted on now, later (tick), or is part
        of the lock/unlock chord."""
        if value == 0:
            self.chord.discard(code)
            if self.pending and self.pending[0] == code:
                self.flush(act)         # a short tap: act on it now
            return
        if code in self.chord:
            return                      # repeats of a chord key
        if (value == 1 and VOLUME_PAIR[code] in held and self.pending
                and self.pending[0] == VOLUME_PAIR[code]):
            # The pair within CHORD_SECONDS: the chord. The first press,
            # still waiting, is cancelled, so the volume does not move. A
            # button held longer has acted already: then this is no chord.
            self.pending = None
            self.chord |= {code, VOLUME_PAIR[code]}
            if self.locked:
                self.unlock(fds, bar)
            else:
                self.lock(fds, bar, held)
            return
        if value == 1:
            self.flush(act)
            self.pending = (code, time.monotonic() + CHORD_SECONDS)
            return
        # Auto-repeat: the first press is no longer waiting for a pair.
        self.flush(act)
        act(code)

    def flush(self, act):
        if self.pending:
            code = self.pending[0]
            self.pending = None
            act(code)

    def timeout(self):
        if not self.pending:
            return None
        return max(0.0, self.pending[1] - time.monotonic())

    def tick(self, act):
        if self.pending and time.monotonic() >= self.pending[1]:
            self.flush(act)


# --- The bar: status while Win is held, and notifications ----------------

GIO_UNIMAP, GIO_CMAP, KDFONTOP = 0x4B66, 0x4B70, 0x4B72
KD_FONT_OP_GET_TALL = 5
I3BLOCKS_RESTART_SECONDS = 5
I3BLOCKS_LINE_LIMIT = 1 << 16
MAX_BLOCKS = 32
MAX_BLOCK_TEXT = 128
MAX_SEPARATOR_CELLS = 4
NOTIFY_SECONDS = 2.5
FOLLOW_SECONDS = 0.5               # how soon a shown bar notices a VT switch
INFO, WARNING, ERROR = "info", "warning", "error"
LEVEL_FG = {INFO: (0xFF, 0xFF, 0xFF), WARNING: (0xFF, 0xFF, 0x00),
            ERROR: (0xFF, 0x00, 0x00)}
URGENT_BG = (0x90, 0x00, 0x00)     # i3bar's urgent block background
BAR_BG = (0x00, 0x00, 0x00)        # i3bar's default background
BAR_FG = (0xFF, 0xFF, 0xFF)
SEPARATOR_FG = (0x66, 0x66, 0x66)  # i3bar's default separator colour
PIXELS_PER_CELL = 10               # i3blocks widths are in pixels


class UniPair(ctypes.Structure):
    _fields_ = [("unicode", ctypes.c_ushort), ("fontpos", ctypes.c_ushort)]


class UniMapDesc(ctypes.Structure):
    _fields_ = [("entry_ct", ctypes.c_ushort),
                ("entries", ctypes.POINTER(UniPair))]


class ConsoleFontOp(ctypes.Structure):
    _fields_ = [("op", ctypes.c_uint), ("flags", ctypes.c_uint),
                ("width", ctypes.c_uint), ("height", ctypes.c_uint),
                ("charcount", ctypes.c_uint),
                ("data", ctypes.c_void_p)]


LIBC = ctypes.CDLL(None, use_errno=True)


def ioctl(fd, request, arg):
    if LIBC.ioctl(fd, ctypes.c_ulong(request), ctypes.byref(arg)) != 0:
        return ctypes.get_errno()
    return 0


def glyph_count(fd):
    """The console font's glyph count (256 or 512), from the font itself:
    with 512 glyphs the 9th glyph bit lives in the screen cell word."""
    for height in (128, 64, 32):
        op = ConsoleFontOp(KD_FONT_OP_GET_TALL, 0, 64, height, 512, None)
        if ioctl(fd, KDFONTOP, op) == 0:
            return op.charcount
    raise OSError("KDFONTOP: cannot read the font metadata")


def font_map(fd):
    """The console font's Unicode map {character: glyph} and whether the
    font has 512 glyphs."""
    desc = UniMapDesc(0, None)
    error = ioctl(fd, GIO_UNIMAP, desc)     # sizing call: ENOMEM + count
    if error not in (0, errno.ENOMEM):
        raise OSError(error, "GIO_UNIMAP")
    pairs = (UniPair * desc.entry_ct)()
    desc = UniMapDesc(len(pairs), ctypes.cast(pairs, ctypes.POINTER(UniPair)))
    error = ioctl(fd, GIO_UNIMAP, desc)
    if error:
        raise OSError(error, "GIO_UNIMAP")
    glyphs = {}
    for pair in pairs[:desc.entry_ct]:
        glyphs.setdefault(chr(pair.unicode), pair.fontpos)
    return glyphs, glyph_count(fd) > 256


def palette(fd):
    buf = bytearray(48)
    fcntl.ioctl(fd, GIO_CMAP, buf)
    return [tuple(buf[i:i + 3]) for i in range(0, 48, 3)]


def nearest(rgb, colors):
    return min(range(len(colors)),
               key=lambda i: sum((a - b) ** 2 for a, b in zip(rgb, colors[i])))


def parse_color(text, default):
    m = re.fullmatch(r"#?([0-9a-fA-F]{6})(?:[0-9a-fA-F]{2})?",
                     text if isinstance(text, str) else "")
    return tuple(bytes.fromhex(m.group(1))) if m else default


def is_icon(ch):
    """Private-use code points: icon-font glyphs, which no console font has."""
    o = ord(ch)
    return 0xE000 <= o <= 0xF8FF or o >= 0xF0000


class I3Blocks:
    """The user's i3blocks, the status_command of their i3 bar, run as the
    user with their session environment and no DISPLAY. Its stdout is the
    i3bar protocol: a header line, then an endless JSON array whose elements
    (one per line) are the current list of blocks. Its output is the user's
    to control, so lines and block lists are bounded."""

    def __init__(self, uid):
        self.uid = uid
        self.blocks = []
        self.proc = None
        self.started = 0.0
        self.buf = b""
        self.lines = 0

    def ensure_running(self):
        if self.proc and self.proc.poll() is None:
            return
        if time.monotonic() - self.started < I3BLOCKS_RESTART_SECONDS:
            return
        self.stop()
        user, identity = user_identity(self.uid)
        self.started = time.monotonic()
        try:
            self.proc = subprocess.Popen(
                ["i3blocks"], **identity, cwd=user.pw_dir,
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            self.proc = None
            return
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.buf, self.lines = b"", 0

    def fileno(self):
        return self.proc.stdout.fileno() if self.proc else None

    def read(self):
        """Consume output; True if the block list changed."""
        try:
            data = os.read(self.fileno(), 65536)
        except BlockingIOError:
            return False
        except OSError:
            data = b""
        if not data:            # i3blocks exited: restarted at a later scan
            self.stop()
            return False
        *lines, self.buf = (self.buf + data).split(b"\n")
        if len(self.buf) > I3BLOCKS_LINE_LIMIT:
            self.buf = b""
        changed = False
        for line in lines:
            if len(line) <= I3BLOCKS_LINE_LIMIT:
                changed |= self.parse(line.strip())
        return changed

    def parse(self, line):
        self.lines += 1
        if self.lines == 1:     # the header
            return False
        if self.lines == 2 and line.startswith(b"["):
            line = line[1:]     # the start of the endless array
        line = line.lstrip(b",")
        try:
            blocks = json.loads(line)
        except ValueError:
            return False
        if not isinstance(blocks, list):
            return False
        self.blocks = [b for b in blocks if isinstance(b, dict)][:MAX_BLOCKS]
        return True

    def stop(self):
        if not self.proc:
            return
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(self.proc.pid, sig)
            except OSError:
                pass
            try:
                self.proc.wait(1)
                break
            except subprocess.TimeoutExpired:
                continue
        self.proc.stdout.close()
        self.proc = None


# Characters the user's i3blocks scripts emit that a console font lacks:
# Font Awesome icons (private use) and a few symbols. Per block name (None:
# any block), each maps to alternatives tried in order against the font;
# the first the font can draw wins. Other icons are dropped: the text next
# to them (percentages, names, times) says what they say.
SUBSTITUTES = {
    "battery": {"\uf0e7": ("\u2191", "+")},      # charging bolt: up arrow
    None: {"\u2716": ("\u2716", "x")},           # volume muted cross
}


def text_cells(text, fg, bg, glyphs, block=None):
    """Screen cells for `text`: characters the font has; else a substitute
    from SUBSTITUTES; else a compatibility form the font has (U+2103 ->
    degree sign, C); else nothing - never a placeholder box."""
    table = {**SUBSTITUTES[None], **SUBSTITUTES.get(block, {})}
    out = []
    for ch in text[:MAX_BLOCK_TEXT]:
        if ch in table:
            for alt in table[ch]:
                if all(c in glyphs for c in alt):
                    out += [(glyphs[c], fg, bg) for c in alt]
                    break
            continue
        if ch in glyphs and not is_icon(ch):
            out.append((glyphs[ch], fg, bg))
            continue
        alt = unicodedata.normalize("NFKD", ch)
        if alt != ch and all(c in glyphs for c in alt):
            out += [(glyphs[c], fg, bg) for c in alt]
    # A dropped icon leaves its spaces behind: no runs, no edges.
    space = glyphs.get(" ", 32)
    out = [c for n, c in enumerate(out)
           if c[0] != space or (n and out[n - 1][0] != space)]
    while out and out[-1][0] == space:
        out.pop()
    return out


def render(blocks, message, cols, glyphs, colors, hi_font):
    """The bar as screen cells: the message (text, level) at the left, the
    status right-aligned like i3bar's - full_text if everything fits, else
    short_text, else cut on the left."""
    fg_default = nearest(BAR_FG, colors)
    bg_default = nearest(BAR_BG, colors[:8])
    space = (glyphs.get(" ", 32), fg_default, bg_default)

    def status(short):
        row = []
        for n, block in enumerate(blocks):
            text = block.get("short_text") if short else None
            text = text or block.get("full_text") or ""
            if not isinstance(text, str):
                continue
            if block.get("markup") == "pango":
                text = re.sub(r"<[^>]*>", "", text)
            text = text.strip()
            if not text:
                continue
            fg = nearest(parse_color(block.get("color"), BAR_FG), colors)
            bg = bg_default
            if block.get("urgent") is True:
                fg, bg = fg_default, nearest(URGENT_BG, colors[:8])
            elif block.get("background"):
                bg = nearest(parse_color(block["background"], BAR_BG),
                             colors[:8])
            row += text_cells(text, fg, bg, glyphs, block.get("name"))
            if n < len(blocks) - 1:
                width = block.get("separator_block_width", 9)
                width = width if isinstance(width, int) else 9
                gap = min(MAX_SEPARATOR_CELLS,
                          max(1, round(width / PIXELS_PER_CELL)))
                sep = [space] * gap
                if block.get("separator", True):
                    sep[gap // 2] = (glyphs.get("|", ord("|")),
                                     nearest(SEPARATOR_FG, colors), bg_default)
                row += sep
        return row + [space]

    left = []
    if message:
        text, level = message
        fg = nearest(LEVEL_FG[level], colors)
        left = text_cells(text, fg, bg_default, glyphs) + [space]
        left = left[:cols]
    room = cols - len(left)
    right = status(False)
    if len(right) > room:
        right = status(True)
    right = right[len(right) - room:] if room > 0 else []
    row = left + [space] * (room - len(right)) + right

    out = bytearray()
    for glyph, fg, bg in row:
        attr = (bg << 4) | fg
        if hi_font:     # fbcon 512-glyph fonts: attr shifted up by one bit
            word = (glyph & 0x1FF) | ((attr & 0x7F) << 9)
        else:
            word = (glyph & 0xFF) | (attr << 8)
        out += struct.pack("=H", word)
    return bytes(out)


class Screen:
    """The bottom row of one VT, as /dev/vcsaN cells (2 bytes) and as the
    /dev/vcsuN text shadow (4 bytes a cell). The shadow is kept by the
    kernel from what programs write and is not touched by vcsa writes, so it
    tells a program's write apart from ours even when the cells are equal."""

    def __init__(self, tty):
        n = tty.removeprefix("/dev/tty")
        self.vcsa, self.vcsu = f"/dev/vcsa{n}", f"/dev/vcsu{n}"
        with open(self.vcsa, "rb") as f:
            self.rows, self.cols = f.read(2)

    def size(self):
        with open(self.vcsa, "rb") as f:
            return tuple(f.read(2))

    def read(self, row):
        """(cells, text shadow) of a row, or None if the read came short."""
        with open(self.vcsa, "rb") as a, open(self.vcsu, "rb") as u:
            cells = os.pread(a.fileno(), self.cols * 2,
                             4 + row * self.cols * 2)
            text = os.pread(u.fileno(), self.cols * 4, row * self.cols * 4)
        if len(cells) != self.cols * 2 or len(text) != self.cols * 4:
            return None
        return cells, text

    def write(self, row, col, cells):
        with open(self.vcsa, "r+b") as a:
            if os.pwrite(a.fileno(), cells,
                         4 + (row * self.cols + col) * 2) != len(cells):
                raise OSError(f"{self.vcsa}: short write")


class Bar:
    """The bottom row of the foreground VT, drawn over whatever program is
    there: the i3blocks status while Win is held, and notifications for a
    few seconds. Cells go through /dev/vcsaN, which neither moves the cursor
    nor reaches the program. When the bar goes away, a cell is put back only
    if it still shows the bar and the program has not written there (vcsu)."""

    def __init__(self):
        self.shown = None       # what is on screen, see show()
        self.win = False        # Win is held
        self.message = None     # (text, level)
        self.expires = 0.0
        self.i3blocks = {}      # uid -> I3Blocks

    def blocks_for(self, uid):
        if uid not in self.i3blocks:
            self.i3blocks[uid] = I3Blocks(uid)
        self.i3blocks[uid].ensure_running()
        return self.i3blocks[uid]

    # The API for the rest of the daemon.

    def win_down(self):
        self.win = True
        self.refresh()

    def win_up(self):
        self.win = False
        self.refresh()

    def notify(self, text, level=INFO):
        """Show `text` at the left of the bar for NOTIFY_SECONDS; a new
        message replaces the old one and restarts the timer."""
        self.message = (" ".join(str(text).split()), level)
        self.expires = time.monotonic() + NOTIFY_SECONDS
        self.refresh()

    def timeout(self):
        """Seconds until the message expires, for the event loop."""
        return max(0.0, self.expires - time.monotonic()) if self.message else None

    def tick(self):
        if self.message and time.monotonic() >= self.expires:
            self.message = None
            self.refresh()

    def update(self, uid):
        if self.shown and self.shown["uid"] == uid:
            self.refresh()

    def follow(self):
        """While shown: notice a VT switch or a new owner of the VT, which
        nothing else reports, and move or drop the bar."""
        if not self.shown:
            return
        tty = foreground_text_vt()
        if tty != self.shown["tty"] or os.stat(tty).st_uid != self.shown["uid"]:
            self.refresh()

    # Drawing.

    def refresh(self):
        tty = foreground_text_vt()
        uid = os.stat(tty).st_uid if tty else None
        # Win alone on a login VT: there is no status to show.
        wanted = tty and (self.message or (self.win and uid != 0))
        if self.shown and (not wanted or self.shown["tty"] != tty
                           or self.shown["uid"] != uid):
            self.hide()     # a new session on the VT is a new screen
        if not wanted:
            return
        if not self.shown:
            screen = Screen(tty)
            row = screen.rows - 1
            snapshot = screen.read(row)
            if snapshot is None:
                return
            self.shown = {"tty": tty, "uid": uid, "screen": screen,
                          "row": row, "saved": bytearray(snapshot[0]),
                          "text": snapshot[1], "written": None}
        self.draw()

    def draw(self):
        shown = self.shown
        screen = shown["screen"]
        if screen.size() != (screen.rows, screen.cols):
            self.shown = None   # resized: our row is gone; leave it
            return
        blocks = self.blocks_for(shown["uid"]).blocks if shown["uid"] else []
        tfd = os.open(shown["tty"], os.O_RDONLY | os.O_NOCTTY)
        try:
            glyphs, hi_font = font_map(tfd)
            colors = palette(tfd)
        finally:
            os.close(tfd)
        row = render(blocks, self.message, screen.cols, glyphs, colors,
                     hi_font)
        if shown["written"] is not None:
            # Cells the program redrew under the bar are its new content.
            current = screen.read(shown["row"])
            if current is None:
                return
            for i in range(screen.cols):
                if self.changed(current, i):
                    shown["saved"][2 * i:2 * i + 2] = current[0][2 * i:2 * i + 2]
            shown["text"] = current[1]
        screen.write(shown["row"], 0, row)
        shown["written"] = row

    def changed(self, current, i):
        """Has cell i been written by the program since we drew it?"""
        shown = self.shown
        cells, text = current
        return (cells[2 * i:2 * i + 2] != shown["written"][2 * i:2 * i + 2]
                or text[4 * i:4 * i + 4] != shown["text"][4 * i:4 * i + 4])

    def hide(self):
        shown, self.shown = self.shown, None
        if not shown or shown["written"] is None:
            return
        self.shown = shown      # for changed()
        try:
            screen = shown["screen"]
            if screen.size() != (screen.rows, screen.cols):
                return
            # The screen may have scrolled while the bar was up: then the bar
            # is higher up, recognised by all its visible (non-blank) cells.
            # Blank cells prove nothing - a program's blank line matches.
            written = shown["written"]
            blank = written[-2:]        # the bar always ends with a space
            visible = [i for i in range(screen.cols)
                       if written[2 * i:2 * i + 2] != blank]
            for row in range(shown["row"], -1, -1):
                current = screen.read(row)
                if current is None:
                    return
                kept = [i for i in range(screen.cols)
                        if not self.changed(current, i)]
                if row == shown["row"] and kept:
                    break
                if visible and set(visible) <= set(kept):
                    break
            else:
                return
            i = 0
            while i < len(kept):        # restore runs of untouched cells
                j = i
                while j + 1 < len(kept) and kept[j + 1] == kept[j] + 1:
                    j += 1
                a, b = kept[i], kept[j] + 1
                screen.write(row, a, bytes(shown["saved"][2 * a:2 * b]))
                i = j + 1
        finally:
            self.shown = None

    def fds(self):
        return {b.fileno(): b for b in self.i3blocks.values()
                if b.fileno() is not None}

    def stop(self):
        self.win, self.message = False, None
        self.hide()
        for b in self.i3blocks.values():
            b.stop()


# --- The console lock (Win+Escape) ----------------------------------------

TTYSECURELOCK = "/usr/local/bin/ttysecurelock"
LOCK_STATE = "/run/tty-i3-keys/lock.json"
# How long a starting lock may take to bring its VT to the front before the
# daemon stops waiting for it (it keeps watching the process either way).
LOCK_START_SECONDS = 5


def process_start(pid):
    """The process's start time (clock ticks since boot), to tell a pid from
    a later process that reuses it."""
    with open(f"/proc/{pid}/stat") as f:
        return int(f.read().rsplit(")", 1)[1].split()[19])


CAP_SYS_TTY_CONFIG = 26


def running_lock():
    """A running ttysecurelock, as {"pid", "start"}, or None. Started by
    root, it runs as the locked user but keeps CAP_SYS_TTY_CONFIG, which no
    process a user starts can have: that tells a real lock from a namesake."""
    for comm in glob.glob("/proc/[0-9]*/comm"):
        pid = int(comm.split("/")[2])
        try:
            with open(comm) as f:
                if f.read().strip() != "ttysecurelock":
                    continue
            if os.readlink(f"/proc/{pid}/exe") != TTYSECURELOCK:
                continue
            with open(f"/proc/{pid}/status") as f:
                caps = [int(line.split()[1], 16) for line in f
                        if line.startswith("CapPrm:")]
            if not caps or not caps[0] >> CAP_SYS_TTY_CONFIG & 1:
                continue
            return {"pid": pid, "start": process_start(pid)}
        except OSError:
            continue
    return None


class Lock:
    """The counterpart of i3's xsecurelock on the text console: ttysecurelock
    (github.com/dmikushin/ttysecurelock), xsecurelock running without X.

    It is xsecurelock itself on a console platform layer. Started as root,
    it locks for the owner of the VT that was in front, passed as --user: it
    takes a free VT from the top (above logind's autovt range), puts it in
    VT_PROCESS mode and refuses every switch away, sets VT_LOCKSWITCH, reads
    the keyboard raw (Ctrl+C, Ctrl+Z, Ctrl+\\ do nothing), then runs as that
    user with CAP_SYS_TTY_CONFIG only, showing xsecurelock's prompt and
    checking passwords with its authproto_pam. On the right password it
    switches back and frees its VT. If it is killed, switching stays locked
    (fail closed).

    It is started in a transient scope of its own (systemd-run --scope), so
    it is outside this daemon's cgroup and session: stopping or restarting
    the daemon leaves the lock in place, and the new daemon adopts it from
    LOCK_STATE. While it runs, the daemon's hotkeys, bar and typing service
    are off. The VT handling is entirely the lock's own; the daemon only
    starts it and watches it."""

    def __init__(self):
        self.state = None       # {"pid", "start"}
        self.pidfd = None
        self.adopt()

    def active(self):
        return self.state is not None

    def fileno(self):
        return self.pidfd

    def lock(self, tty, bar):
        if self.active():
            return
        uid = os.stat(tty).st_uid
        if uid == 0:
            return              # a login prompt: there is no session to lock
        if not os.access(TTYSECURELOCK, os.X_OK):
            bar.notify("Lock: ttysecurelock is not installed", ERROR)
            return
        bar.stop()              # nothing of the session stays on screen
        name = pwd.getpwuid(uid).pw_name
        back = tty.removeprefix("/dev/")
        # systemd-run --scope execs the lock itself in a new scope: the pid
        # is the lock's. "--" ends systemd-run's options ("--user" is one of
        # them too), so the rest is the lock's command line.
        proc = subprocess.Popen(
            ["systemd-run", "--scope", "--quiet", "--collect",
             f"--unit=ttysecurelock-{name}-{time.monotonic_ns()}",
             "--", TTYSECURELOCK, "--user", name],
            stdin=subprocess.DEVNULL, start_new_session=True)
        # The state first: a daemon that dies from here on leaves it for its
        # successor, which adopts the running lock.
        self.state = {"pid": proc.pid, "start": process_start(proc.pid)}
        self.pidfd = os.pidfd_open(proc.pid)
        os.makedirs(os.path.dirname(LOCK_STATE), mode=0o700, exist_ok=True)
        with open(LOCK_STATE + ".new", "w") as f:
            json.dump(self.state, f)
        os.replace(LOCK_STATE + ".new", LOCK_STATE)
        deadline = time.monotonic() + LOCK_START_SECONDS
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                # Refused before locking (no free VT, unknown user, ...):
                # its reason is in the journal.
                self.finish()
                bar.notify(f"Lock: ttysecurelock failed ({proc.returncode})",
                           ERROR)
                return
            with open("/sys/class/tty/tty0/active") as f:
                if f.read().strip() != back:
                    return      # its VT is in front: locked
            time.sleep(0.02)

    def adopt(self):
        """A lock left by a previous run of the daemon: keep watching it, or
        forget it if it has ended. A lock running without LOCK_STATE (the
        daemon died between starting it and recording it, or someone ran
        ttysecurelock by hand) is adopted too: whatever locks the consoles,
        the daemon must stay off while it runs."""
        state = None
        try:
            with open(LOCK_STATE) as f:
                state = json.load(f)
            if process_start(state["pid"]) != state["start"]:
                state = None
        except (OSError, ValueError, KeyError, TypeError):
            state = None
        if state is None:
            state = running_lock()
        if state is not None:
            try:
                self.pidfd = os.pidfd_open(state["pid"])
                self.state = state
                return
            except OSError:
                pass
        self.finish()

    def ended(self):
        """Called when the pidfd is readable: the lock has exited."""
        try:
            os.waitpid(self.state["pid"], os.WNOHANG)
        except ChildProcessError:
            pass                # adopted: not our child
        self.finish()

    def finish(self):
        """Forget the lock. The VTs are its business: unlocked, it has gone
        back and freed its VT; killed, it leaves switching locked on purpose."""
        self.state = None
        if self.pidfd is not None:
            os.close(self.pidfd)
            self.pidfd = None
        try:
            os.unlink(LOCK_STATE)
        except FileNotFoundError:
            pass


# --- Typing on the console for its owner (nerd-dictation) -----------------

TYPE_SOCKET = "/run/tty-i3-keys-type.sock"
TYPE_MAX_BYTES = 16 * 1024
TYPE_CLIENT_SECONDS = 2         # a client must have sent all its text by then
# Pause after each character, like a keyboard: a program may read its input
# one key at a time and lose keys that arrive back to back (the Dario prompt
# dropped whole words when a dictated phrase came in as one burst). 12 ms is
# xdotool type's default delay, which nerd-dictation relies on under X.
TYPE_CHAR_SECONDS = 0.012
TYPE_MAX_CLIENTS = 4
TIOCSTI = 0x5412
UCRED = struct.Struct("3i")     # struct ucred: pid, uid, gid


class TypeService:
    """Type text into the foreground text VT for the user who owns it.

    A user process cannot inject input into a VT: TIOCSTI on a terminal that
    is not its controlling one needs CAP_SYS_ADMIN (dev.tty.legacy_tiocsti
    is 0). nerd-dictation types its text through this socket when the
    console, not X, is in front. Protocol: connect, send the UTF-8 bytes,
    shut down the sending side, read one reply line:
      ok        typed, at keyboard pace (TYPE_CHAR_SECONDS per character),
                so the reply comes when the last character is in (an empty
                request only asks, and types nothing);
      x         the VT in front is in graphics mode: X takes the text;
      denied: <reason>   not typed.
    Who may type is decided by the peer's uid (SO_PEERCRED), not by the
    socket's mode: only into a VT that this uid owns, never a root-owned
    (login) VT, never while the console lock is on. The VT in front is
    checked again while typing, so a switch mid-text stops it."""

    def __init__(self, lock):
        self.lock = lock
        self.slots = threading.BoundedSemaphore(TYPE_MAX_CLIENTS)
        try:
            os.unlink(TYPE_SOCKET)
        except FileNotFoundError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(TYPE_SOCKET)
        os.chmod(TYPE_SOCKET, 0o666)
        self.sock.listen(TYPE_MAX_CLIENTS)

    def fileno(self):
        return self.sock.fileno()

    def accept(self):
        conn, _ = self.sock.accept()
        if not self.slots.acquire(blocking=False):
            self.reply(conn, "denied: busy")
            conn.close()
            return
        threading.Thread(target=self.serve, args=(conn,), daemon=True).start()

    @staticmethod
    def reply(conn, text):
        try:
            conn.sendall(text.encode() + b"\n")
        except OSError:
            pass

    def serve(self, conn):
        try:
            uid = UCRED.unpack(conn.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, UCRED.size))[1]
            # One deadline for the whole request, not per recv: a client
            # trickling bytes must not hold a slot for ever.
            deadline = time.monotonic() + TYPE_CLIENT_SECONDS
            data = b""
            try:
                while len(data) <= TYPE_MAX_BYTES:
                    left = deadline - time.monotonic()
                    if left <= 0:
                        raise socket.timeout
                    conn.settimeout(left)
                    chunk = conn.recv(TYPE_MAX_BYTES + 1 - len(data))
                    if not chunk:
                        break
                    data += chunk
            except socket.timeout:
                self.reply(conn, "denied: the text did not arrive in time")
                return
            if len(data) > TYPE_MAX_BYTES:
                self.reply(conn, f"denied: more than {TYPE_MAX_BYTES} bytes")
                return
            self.reply(conn, self.type(uid, data))
        except Exception:
            traceback.print_exc()
        finally:
            conn.close()
            self.slots.release()

    def type(self, uid, data):
        with open("/sys/class/tty/tty0/active") as f:
            tty = "/dev/" + f.read().strip()
        fd = os.open(tty, os.O_RDONLY | os.O_NOCTTY)
        try:
            mode = bytearray(4)
            fcntl.ioctl(fd, KDGETMODE, mode)
            if struct.unpack("i", mode)[0] != KD_TEXT:
                return "x"
            owner = os.fstat(fd).st_uid
            if self.lock.active():
                return "denied: the console is locked"
            if owner == 0 or owner != uid:
                return "denied: the console in front is not yours"
            # Every character goes in only while the VT is still in front,
            # still this user's and not locked: a switch, a logout or
            # Win+Escape mid-text stops the rest. (The fd stays bound to this
            # VT, so a switch could never send the text to another one.) The
            # bytes of one character go in together, then the key pause.
            text = data.decode("utf-8", errors="replace")
            with open("/sys/class/tty/tty0/active") as active:
                for char in text:
                    active.seek(0)
                    if "/dev/" + active.read().strip() != tty:
                        return "denied: the console was switched"
                    if os.fstat(fd).st_uid != uid or self.lock.active():
                        return "denied: the console changed hands"
                    for byte in char.encode():
                        fcntl.ioctl(fd, TIOCSTI, bytes([byte]))
                    time.sleep(TYPE_CHAR_SECONDS)
            return "ok"
        finally:
            os.close(fd)

    def stop(self):
        self.sock.close()
        try:
            os.unlink(TYPE_SOCKET)
        except FileNotFoundError:
            pass


def handle(held, device, code, value, media_keys, last_media, bar, lock, kbd,
           fds, act, dictation):
    """One key event from any keyboard."""
    if value == 0:
        owner = last_media.get(code, (0.0, None))[1]
        if code in media_keys and owner not in (None, device):
            return      # the release of a press the duplicate filter dropped
        held.discard(code)
        if kbd.grab_pending:
            kbd.settle(fds, held)
        if code in VOLUME_PAIR and kbd.possible:
            kbd.volume_key(code, 0, held, fds, bar, act)
        if code in WIN and not held & WIN:
            bar.win_up()
        return
    first_win = code in WIN and value == 1 and not held & WIN
    held.add(code)
    if code in media_keys:
        # One press can arrive from two devices: the first device to report
        # it owns the press, and only its repeats (value 2, which keep
        # changing the level as under X) act.
        now = time.monotonic()
        when, owner = last_media.get(code, (0.0, None))
        if value == 1:
            if owner != device and now - when < DUPLICATE_SECONDS:
                return
            last_media[code] = (now, device)
        elif owner != device:
            return
        if code in VOLUME_PAIR and kbd.possible:
            # Also the keyboard lock's chord, so before anything is dropped.
            kbd.volume_key(code, value, held, fds, bar, act)
            return
    if kbd.locked:
        return      # the keyboard is locked: every other key is dropped
    if lock.active():
        return      # locked: no bar, no actions on the user's behalf
    if first_win:
        bar.win_down()
    if code in media_keys:
        act(code)
        return
    if code == DICTATION_KEY:
        # The configured key alone (repeats ignored): the dictation toggle.
        if value == 1 and not held & (WIN | CTRL_ALT):
            tty = foreground_text_vt()
            if tty:
                dictation.toggle(tty, bar)
        return
    if value != 1 or not held & WIN or held & CTRL_ALT:
        return
    if code == KEY_K and not held & SHIFT:
        kbd.lock(fds, bar, held)
    elif code == KEY_ESC and not held & SHIFT:
        tty = foreground_text_vt()
        if tty:
            lock.lock(tty, bar)
    elif code == KEY_S and held & SHIFT:
        tty = foreground_text_vt()
        if tty:
            toggle(tty, bar)
    elif code == KEY_O and not held & SHIFT:
        if foreground_text_vt():
            rotate(bar)
    elif code in WINDOW_KEYS and not held & SHIFT:
        tty = foreground_text_vt()
        if tty:
            select_window(tty, WINDOW_KEYS[code], bar)


def media_action(kbd, lock, bar):
    """The volume/brightness action for a media key. Under X the window
    manager has the keys - unless the keyboard is locked (grabbed), when X
    gets nothing and the daemon acts for the owner of the VT in front. Not
    while the console lock is on."""
    def act(code):
        if lock.active():
            return
        tty = foreground_text_vt()
        if tty is None:
            if not kbd.locked:
                return
            tty = foreground_vt()
        (volume if code in VOLUME else brightness)(tty, code, bar)
    return act


def run(keymap, media_keys, bar, lock, typer, kbd, dictation):
    fds = {}
    held = set()
    last_media = {}
    act = media_action(kbd, lock, bar)
    next_scan = 0.0
    while True:
        if time.monotonic() >= next_scan:
            try:
                scan(fds, media_keys)
                if kbd.locked and not kbd.grab_pending:
                    kbd.grab(fds)       # keyboards plugged in while locked
                keymap.apply()
                if not lock.active():
                    lock.adopt()        # a lock this daemon did not record
                # Keep the bar's content ready for the user in front.
                tty = foreground_text_vt()
                if tty and os.stat(tty).st_uid != 0:
                    bar.blocks_for(os.stat(tty).st_uid)
            except Exception:   # retried at the next scan
                traceback.print_exc()
            # Locked: a keyboard plugged in is grabbed within a second.
            next_scan = time.monotonic() + (1 if kbd.locked else RESCAN_SECONDS)
        status = bar.fds()
        wait = RESCAN_SECONDS
        if bar.timeout() is not None:
            wait = min(wait, bar.timeout())
        if kbd.timeout() is not None:
            wait = min(wait, kbd.timeout())
        if dictation.timeout() is not None:
            wait = min(wait, dictation.timeout())
        if bar.shown:
            wait = min(wait, FOLLOW_SECONDS)
        watched = list(fds) + list(status)
        if lock.fileno() is not None:
            watched.append(lock.fileno())
        watched.append(typer.fileno())
        if dictation.fileno() is not None:
            watched.append(dictation.fileno())
        ready, _, _ = select.select(watched, [], [], wait)
        try:
            kbd.tick(act)
            dictation.tick(bar)
            bar.tick()
            bar.follow()
        except Exception:
            traceback.print_exc()
        for fd in ready:
            if fd == typer.fileno():
                try:
                    typer.accept()
                except Exception:
                    traceback.print_exc()
                continue
            if fd == lock.fileno():
                try:
                    lock.ended()
                except Exception:
                    traceback.print_exc()
                continue
            if fd == dictation.fileno():
                try:
                    dictation.ready(bar)
                except Exception:
                    traceback.print_exc()
                continue
            if fd in status:
                try:
                    if status[fd].read():
                        bar.update(status[fd].uid)
                except Exception:
                    traceback.print_exc()
                continue
            try:
                data = os.read(fd, EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b""
            if not data:  # device unplugged: forget what it held down
                del fds[fd]
                kbd.forget(fd, fds, bar)
                os.close(fd)
                if held & WIN:
                    bar.win_up()
                held.clear()
                if kbd.grab_pending:
                    kbd.settle(fds, held)
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, type_, code, value = EVENT.unpack_from(data, i)
                if type_ != EV_KEY:
                    continue
                try:
                    handle(held, fd, code, value, media_keys, last_media, bar,
                           lock, kbd, fds, act, dictation)
                except Exception:   # one failed action must not end the daemon
                    traceback.print_exc()


def load_config(path):
    """Per-machine settings. Only one so far:

      dictation_key = 127   # evdev keycode that toggles the console owner's
                            # nerd-dictation; for a machine without a middle
                            # mouse button (yoga3: the Menu key, 127).
                            # Absent: no dictation key.
    """
    global DICTATION_KEY
    try:
        with open(path, "rb") as f:
            config = tomllib.load(f)
    except FileNotFoundError:
        return
    key = config.get("dictation_key")
    if key is not None:
        if not isinstance(key, int) or not 0 < key < 768:
            sys.exit(f"{path}: dictation_key must be an evdev keycode, got {key!r}")
        DICTATION_KEY = key
        print(f"dictation key: keycode {key}", flush=True)


DICTATION_KEY = None


def main():
    load_config(sys.argv[sys.argv.index("--config") + 1]
                if "--config" in sys.argv else CONFIG)
    media_keys = set(VOLUME) | set(BRIGHTNESS)
    reserved = console_toggle_keys() & media_keys
    if reserved:
        print(f"left to the console keymap: keycodes {sorted(reserved)}",
              flush=True)
    media_keys -= reserved
    entries = {code: K_SHIFTL for code in WIN}
    entries.update({code: K_HOLE for code in media_keys})
    # The dictation key must not also be a console key.
    if DICTATION_KEY is not None and DICTATION_KEY not in console_toggle_keys():
        entries[DICTATION_KEY] = K_HOLE
    keymap = Keymap(entries)
    restore_rotation()
    bar = Bar()
    lock = Lock()
    typer = TypeService(lock)
    kbd = KeyboardLock(media_keys)
    dictation = Dictation()
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(0))
    try:
        run(keymap, media_keys, bar, lock, typer, kbd, dictation)
    finally:
        try:
            dictation.stop()
            kbd.stop()
            typer.stop()
            bar.stop()
        finally:
            keymap.restore()


if __name__ == "__main__":
    main()
