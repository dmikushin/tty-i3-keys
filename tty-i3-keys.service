[Unit]
Description=i3 hotkeys on text consoles (Win+1..0 tmux windows, Win+Escape lock, Win+Shift+S lid suspend)

[Service]
ExecStart=/usr/local/bin/tty-i3-keys
Restart=always
# The toggle script leaves a systemd-inhibit process running, which must
# survive restarts of this daemon. (The console lock, ttysecurelock, runs in
# a scope of its own, outside this unit.)
KillMode=process

[Install]
WantedBy=multi-user.target
