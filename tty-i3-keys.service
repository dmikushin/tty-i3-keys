[Unit]
Description=i3 hotkeys on text consoles (Win+1..0 tmux windows, Win+Shift+S lid suspend)

[Service]
ExecStart=/usr/local/bin/tty-i3-keys
Restart=always
# The toggle script leaves a systemd-inhibit process running; it must
# survive restarts of this daemon.
KillMode=process

[Install]
WantedBy=multi-user.target
